                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"entries\": [\n    {\n      \"quantity\": \"<number>\",\n      \"item\": \"<string>\",\n      \"measure\": \"http://www.edamam.com/ontologies/edamam.owl#Measure_serving\"\n    },\n    {\n      \"quantity\": \"<number>\",\n      \"item\": \"<string>\",\n      \"measure\": \"http://www.edamam.com/ontologies/edamam.owl#Measure_serving\"\n    }\n  ]\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/api/shopping-list/v2?beta=<boolean>&shopping-cart=<boolean>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "shopping-list",
                        "v2"
                      ],
                      "query": [
                        {
                          "description": "Turn on support for beta features",
                          "key": "beta",
                          "value": "<boolean>"
                        },
                        {
                          "description": "(BETA only) Generate a shopping cart page for the the foods aggregated in the shopping list",
                          "key": "shopping-cart",
                          "value": "<boolean>"
                        }
                      ]
                    }
                  },
