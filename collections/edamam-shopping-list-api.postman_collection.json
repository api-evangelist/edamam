{
  "info": {
    "_postman_id": "8a380a5e-c27a-4865-8769-0ce0b4206c7f",
    "name": "Recipe Search Shopping List API",
    "description": "The *Shopping List API* provides aggregation of shopping item quantities over one or more ingredient lists, and\noptional referral to external shopping services.\n\nA `shopping-list` call may be issued on a recipe preparation plan, e.g. for recipes assigned to a meal plan's\nslots, to obtain total shopping quantities for the products involved. Each item in the plan may be scaled\nindividually for the shopping list by indicating the planned consumption as a number of servings; in the absence\nof such indication, consumption (and therefore preparation) of the complete output of the recipe will be assumed.\nBoth recipes and directly consumable foodstuffs are supported as items in the plan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:18:37.000Z",
    "updatedAt": "2026-10-22T01:18:38.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-8a380a5e-c27a-4865-8769-0ce0b4206c7f"
  },
